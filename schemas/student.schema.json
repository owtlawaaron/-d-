{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seat-wars/schemas/student.schema.json",
  "title": "Roster",
  "type": "object",
  "required": ["roster"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "classId": { "type": "string" },
    "roster": { "type": "array", "minItems": 1, "maxItems": 48, "items": { "$ref": "#/$defs/student" } }
  },
  "$defs": {
    "student": {
      "type": "object",
      "required": ["id", "name", "stats", "personality"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "name": { "type": "string" },
        "playable": { "type": "boolean", "default": false },
        "stats": {
          "type": "object",
          "required": ["athletics", "nerve", "academics", "charisma", "stamina"],
          "additionalProperties": false,
          "properties": {
            "athletics": { "$ref": "#/$defs/stat" },
            "nerve": { "$ref": "#/$defs/stat" },
            "academics": { "$ref": "#/$defs/stat" },
            "charisma": { "$ref": "#/$defs/stat" },
            "stamina": { "$ref": "#/$defs/stat" }
          }
        },
        "personality": { "enum": ["hothead", "calculator", "loyal", "pacifist", "tyrant", "avenger"] },
        "preferences": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": -15, "maximum": 15 }
        },
        "friends": { "type": "array", "items": { "type": "string" } },
        "rivals": { "type": "array", "items": { "type": "string" } },
        "loadout": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "primary": { "type": "string" }, "secondary": { "type": "string" }
          }
        },
        "appearance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hair": { "enum": ["short", "spike", "bob", "long", "ponytail", "buzz"] },
            "hairColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            "skin": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            "height": { "type": "number", "minimum": 1.3, "maximum": 2.0 }
          }
        }
      }
    },
    "stat": { "type": "integer", "minimum": 1, "maximum": 10 }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seat-wars/schemas/arena.schema.json",
  "title": "Arena",
  "type": "object",
  "required": ["id", "scale", "bounds", "attackerSpawns", "waypoints"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "name": { "type": "string" },
    "scale": { "type": "number", "minimum": 1, "maximum": 4 },
    "bounds": { "$ref": "#/$defs/vec3obj" },
    "colliders": { "type": "array", "items": { "$ref": "#/$defs/collider" } },
    "cover": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": { "enum": ["seat_grid", "explicit"] },
        "deskSize": { "$ref": "#/$defs/vec3" }
      }
    },
    "attackerSpawns": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/vec3" } },
    "spawnFlipWhenDefenderRow": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "gte": { "type": "integer" }, "lte": { "type": "integer" } }
    },
    "highGround": { "type": "array", "items": { "$ref": "#/$defs/collider" } },
    "waypoints": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/waypoint" } },
    "genesisTimeline": { "type": "string", "description": "genesis タイムライン JSON の id" }
  },
  "$defs": {
    "vec3": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
    "vec3obj": {
      "type": "object",
      "required": ["x", "y", "z"],
      "additionalProperties": false,
      "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" } }
    },
    "collider": {
      "type": "object",
      "required": ["pos", "size"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["box"], "default": "box" },
        "pos": { "$ref": "#/$defs/vec3" },
        "size": { "$ref": "#/$defs/vec3" },
        "tag": { "type": "string" },
        "penetrable": { "type": "boolean", "default": false },
        "hp": { "type": "number", "minimum": 0 }
      }
    },
    "waypoint": {
      "type": "object",
      "required": ["id", "pos", "links"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "pos": { "$ref": "#/$defs/vec3" },
        "links": { "type": "array", "items": { "type": "string" } },
        "cover": { "type": "boolean", "default": false },
        "role": { "enum": ["any", "attacker", "defender"], "default": "any" }
      }
    }
  }
}

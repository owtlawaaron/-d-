{
  "$schema": "../../schemas/seat_layout.schema.json",
  "id": "standard_6x5",
  "name": "標準教室（6列×5行 / 30席）",
  "cols": 6,
  "rows": 5,
  "origin": { "x": -3.25, "z": -2.2 },
  "pitch": { "x": 1.3, "z": 1.35 },
  "baseValue": 50,
  "tagRules": [
    { "tag": "back_row", "label": "後方席", "when": { "row": { "gte": 3 } }, "weight": 18 },
    { "tag": "window_side", "label": "窓際", "when": { "col": { "eq": 5 } }, "weight": 16 },
    { "tag": "corner_king", "label": "窓際最後列（玉座）", "when": { "col": { "eq": 5 }, "row": { "eq": 4 } }, "weight": 10 },
    { "tag": "aircon_zone", "label": "エアコン直下", "when": { "col": { "gte": 4 }, "row": { "lte": 1 } }, "weight": 12,
      "seasonal": { "spring": 2, "summer": 12, "autumn": 2, "winter": -8 } },
    { "tag": "center_screen", "label": "板書ベストポジション", "when": { "col": { "in": [2, 3] }, "row": { "in": [1, 2] } }, "weight": 4 },
    { "tag": "front_row", "label": "最前列", "when": { "row": { "eq": 0 } }, "weight": -20 },
    { "tag": "teacher_desk_adjacent", "label": "教卓の真ん前", "when": { "col": { "lte": 1 }, "row": { "eq": 0 } }, "weight": -12 },
    { "tag": "door_side", "label": "廊下側", "when": { "col": { "eq": 0 } }, "weight": -6 },
    { "tag": "cleaning_locker", "label": "掃除ロッカー隣", "when": { "col": { "eq": 0 }, "row": { "eq": 4 } }, "weight": -8 },
    { "tag": "projector_glare", "label": "スクリーンが見づらい", "when": { "col": { "gte": 4 }, "row": { "lte": 1 } }, "weight": -5 }
  ]
}
